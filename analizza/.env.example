# ── Supabase (progetto `plainer`, schema `analizza`) ─────────────────────
SUPABASE_URL=https://fxhspbatfipellryixjy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # Dashboard Supabase -> Settings -> API. Solo server, mai NEXT_PUBLIC_.

# ── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                # console.anthropic.com
MODEL_EXTRACT=claude-sonnet-5-5   # estrazione voci; promosso solo se i test lo validano
MODEL_WRITE=claude-opus-5-5       # scrittura del report

# ── Email (solo OTP, nessuna mail di risultato) ───────────────────────────
RESEND_API_KEY=                   # resend.com — tetto gratuito 100/giorno
EMAIL_FROM=Plainer <verifica@plainer.it>

# ── Sicurezza ─────────────────────────────────────────────────────────────
OTP_PEPPER=                       # stringa casuale lunga (openssl rand -hex 32)
RATE_LIMIT_PEPPER=                # stringa casuale lunga, diversa dalla precedente

# ── Interruttori e tetti ──────────────────────────────────────────────────
ANALYSIS_ENABLED=false            # kill switch: finche' e' false l'analisi risponde 503
DAILY_ANALYSIS_CAP=50             # tetto globale di analisi al giorno
BENCHMARK_MIN_SAMPLES=20          # campioni minimi per (categoria, provincia)
INFORMATIVA_VERSIONE=2026-10
